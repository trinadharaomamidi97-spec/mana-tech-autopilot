# Copy to .env locally. Never commit real credentials.
# AI script generation
GEMINI_API_KEY=

# Instagram Graph API (configure only after Meta permissions are verified)
META_APP_ID=
META_APP_SECRET=
META_IG_USER_ID=
META_ACCESS_TOKEN=

# Storage: use a private bucket and short-lived/publicly accessible
# media URLs only where required by the Instagram publishing API.
MEDIA_STORAGE_PROVIDER=
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=

# Telugu text-to-speech provider
TTS_PROVIDER=
TTS_API_KEY=
TTS_VOICE_ID=

# Stock footage provider (respect each provider's license and API terms)
STOCK_VIDEO_PROVIDER=
STOCK_VIDEO_API_KEY=

# Database / application
DATABASE_URL=
APP_BASE_URL=
